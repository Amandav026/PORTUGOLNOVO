programa{
	funcao inicio(){
       inteiro i
       real soma = 0
       inteiro quantidade = (100 - 15) + 1
       real media

       para(i=15;i<=100;i++){
       	soma = soma + i
       }
       media = soma / quantidade
       escreva("A média aritmética dos inteiros entre 15 e 100 é: ", media)
       escreva("\n")
       }
     



		
	
}
