programa{
	funcao inicio(){
         inteiro i
         inteiro j
         inteiro resultado

         para(i=1;i<=10;i++){
         	escreva("\n")
         	escreva("TABUADA DO ", i ,":")
         	escreva("\n")

         para(j=1;j<=10;j++){
         	resultado = i * j
         	escreva(i, " X ", j , " = ", resultado)
         	escreva("\n")
         }
         }
         }
        

		
	
}
