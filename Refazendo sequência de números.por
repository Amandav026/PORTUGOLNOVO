programa{
	funcao inicio(){
        inteiro i
        inteiro A


        para(i=1;i<=10;i++){
        	escreva("(",i,", ")

        para(A=1;A<=10;A++){
        	escreva(A)
        	se(A<10){
        	escreva(" ")
        }
        }
       
       
        escreva(")\n")
        }
	}
        

		
	
}
