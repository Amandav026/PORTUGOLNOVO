programa{
	funcao inicio(){
       inteiro numero
       inteiro i
       inteiro soma = 0

       para(i=1;i<=10;i++){
       	escreva("Digite o ", i ,"° número: ")
       	leia(numero)
       	escreva("\n")

       	soma = soma + numero

       }
       escreva("A soma total dos números lidos é: ", soma)


       
       	}
       
       


	 
	
}
