programa{
      funcao calcularDobro(inteiro numero, inteiro dobro){
      	dobro = numero * 2
      	escreva("O dobro do ", numero," é: ",dobro)
      }

     
	funcao inicio(){
	inteiro numero
	inteiro dobro = 0

	escreva("Digite um número: ")
	leia(numero)
	escreva("\n")

	calcularDobro(numero,dobro)
      



	
	}
}
