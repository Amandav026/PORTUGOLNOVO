programa{
	funcao inicio(){
       inteiro i
       inteiro j

       para(i=1;i<=10;i++){
       	escreva("(",i, ", ")

       	para(j=1;j<=10;j++){
       		escreva(j)
       		se(j<10){
       			escreva(" ")
       		}
       	}
       	escreva(")\n")
       	}
       }


		
	
}
