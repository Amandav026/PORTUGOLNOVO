programa{
	funcao inicio(){
        inteiro valor
        inteiro i
        inteiro soma = 0

        para(i=1;i<=10;i++){
        	escreva("Digite o ", i ,"° valor: ")
        	leia(valor)
        	escreva("\n")

        	se(valor<0){
        		soma = soma + 1
        	}
        }
        escreva("Nesta lista de valores ", soma ," são valores NEGATIVOS")
        	}
        



		
	
}
