programa{
	funcao inicio(){
        inteiro i
        inteiro resultado

        escreva("Segue a tabuada de 8 na multiplicação: ")
        escreva("\n")
        escreva("\n")
         
        para(i=1;i<=10;i++){
        	  resultado = 8 * i
        	  escreva("8 x ", i , " = ", resultado)
        	  escreva("\n")
        }
        
   



	  
	}
}
